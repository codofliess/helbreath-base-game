# PostgreSQL (same DATABASE_URL on game server + middleware)
DATABASE_URL=postgresql://helbreath:helbreath@localhost:5432/helbreath

# Wallet auth (optional in dev; when set, only Phantom wallet sessions can connect)
# Must match middleware-node WALLET_AUTH_SECRET in production.
# WALLET_AUTH_SECRET=change-me-in-production

# Isolated playtest door (no Phantom, char ElonQa, saves in CharsPlaytest/).
# Never set this on the live Hetzner process. Incompatible with WALLET_AUTH_SECRET / DATABASE_URL / HELL_MINT.
# PLAYTEST=1

# One-row live overlay for character Elon only (ops/apply-live-elon-warrior-kit.py).
# Must stay unset on the game process. The script also requires --apply.
# ALLOW_LIVE_ELON_KIT=1
