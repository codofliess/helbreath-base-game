PORT=3001

# Market side door
MARKET_PAY_MODE=dev
MARKET_FEE_PERCENT=5
MARKET_TREASURY_WALLET=
MARKET_SYNC_SECRET=change-me-shared-with-game
MARKET_DATA_DIR=./data
# Optional: load game auction board JSON
# AUCTION_BOARD_JSON=../multiplayer/server/Chars/auction-board.json

# xAI — see docs/GROK-MODEL-ROUTING.md
XAI_API_KEY=
# FAQ-tier (cheap): Discord parity + /market/advisor
XAI_MODEL_FAQ=grok-4-1-fast-non-reasoning
XAI_MODEL_MARKET=grok-4-1-fast-non-reasoning
# In-game assistant quality tier
XAI_MODEL_INGAME=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1
# XAI_INGAME_MAX_TOKENS=700

# Solana
# RPC_URL=https://api.devnet.solana.com
WALLET_AUTH_SECRET=

# PostgreSQL (required in production for leaderboard, drops, tournaments)
# Railway: Variables → Add Reference → Postgres service → DATABASE_URL
# Value template (do not commit secrets):
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=
