<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.34.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Grpc.Tools" Version="2.78.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../proto/**/*.proto" ProtoRoot="../proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Persistence\schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="PlaytestKits\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Config\ArenaPrizeWhitelist.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Never ship player data / nested publish trees into the build output. -->
  <ItemGroup>
    <Content Remove="Chars/**" />
    <Content Remove="**/publish*/**" />
    <Content Remove="_build_check_out/**" />
    <None Remove="Chars/**" />
    <None Remove="**/publish*/**" />
    <None Remove="_build_check_out/**" />
  </ItemGroup>

</Project>
