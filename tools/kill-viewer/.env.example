# Names only. Never commit values. Load from your secret manager.
PUBLIC_DB_URL=
PUBLIC_PORT=8787
# Fail closed when blank: times coarsened to the UTC day (no finer bucket decided).
PUBLIC_TIME_ROUND_MINUTES=
# Required for publishing. Blank = hide all kills. No delay duration decided.
PUBLIC_PUBLISH_DELAY_HOURS=
# Required for loot. Blank = hide loot. No delay duration decided.
PUBLIC_LOOT_REVEAL_DELAY_HOURS=
# On-chain subtitle/footer. Leave false until a contract is deployed.
KILL_LEDGER_ONCHAIN_DEPLOYED=false
ADMIN_DB_URL=
ADMIN_PORT=8788
ADMIN_HOST=127.0.0.1
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_AUDIENCE=
ADMIN_OIDC_JWKS_URL=
ADMIN_ROLE_CLAIM=roles
ADMIN_REQUIRED_ROLE=ops_admin
ADMIN_IP_ALLOWLIST=
ADMIN_TRUST_PROXY=0
ADMIN_DEV_JWT_SECRET=
