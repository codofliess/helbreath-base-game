# Copy to /opt/chainlords/ops/config.env and fill secrets.

CORE_SERVER_NAME=chainlords-play
HCLOUD_TOKEN=

# Core metrics (game on same host)
ONLINE_URL=http://127.0.0.1:1337/api/realm-stats

# Autoscale thresholds (concurrent sessions ≈ ON)
HOT_UP_ONLINE=45
HOT_DOWN_ONLINE=20
HOT_DOWN_STREAK=6

# Prefer cheapest/best first; first type available for resize wins
CORE_TYPES=cx53,cx43,cpx42,cx33,cpx32

HOT_TYPE=cx43
HOT_LOCATION=fsn1
HOT_SERVER_NAME=chainlords-hot
HOT_IMAGE=ubuntu-24.04

# SSH key name already in Hetzner (create once)
SSH_KEY_NAME=chainlords-setup

# Optional Discord notify (mining + daily QA fails)
DISCORD_WEBHOOK_URL=
# Optional email for QA audit (requires mailx on host)
MAIL_TO=
# Set 1 to Discord even when QA is green
NOTIFY_ON_OK=0

# Safety: set 1 to allow create/destroy/resize
AUTOSCALE_ENABLED=1
UPGRADE_CORE_ENABLED=1
