# Discord Developer Portal → Bot → Token
# Enable intents: Message Content, Server Members (optional), Direct Messages
DISCORD_BOT_TOKEN=

# Server ID (Developer Mode → right-click server → Copy Server ID) — required for setup-server.mjs
DISCORD_GUILD_ID=

# Optional: only answer in these channel IDs (comma-separated). Empty = DMs + any channel where bot is @mentioned
DISCORD_SUPPORT_CHANNEL_IDS=

# Optional: log every reply to this channel ID
DISCORD_OPS_LOG_CHANNEL_ID=

# Set to 1 ONLY after enabling Privileged Gateway Intent "Message Content Intent"
# in Discord Developer Portal → Bot. Without it the bot still runs: /faq + DMs.
# DISCORD_MESSAGE_CONTENT=1

# xAI API — https://console.x.ai/
XAI_API_KEY=
# FAQ channel (cheap / high volume). See docs/GROK-MODEL-ROUTING.md
XAI_MODEL_FAQ=grok-4-1-fast-non-reasoning
# Legacy alias (same as XAI_MODEL_FAQ if FAQ unset)
# XAI_MODEL=grok-4-1-fast-non-reasoning
XAI_BASE_URL=https://api.x.ai/v1
# Optional usage log path (default: data/xai-usage.jsonl)
# XAI_USAGE_LOG=

# Official links injected into system prompt
OFFICIAL_PLAY_URL=https://play.chainlords.net
OFFICIAL_DISCORD_URL=https://discord.gg/F4NwwbfKtj
OFFICIAL_X_URL=https://x.com/ChainLordsHQ

# X API v2 OAuth 1.0a (Developer Console → app → Keys and tokens)
# Post as @ChainLordsHQ — see docs/social/X-API-SETUP.md
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# Content ops (/content slash) — optional channel IDs
# DISCORD_ANNOUNCE_CHANNEL_ID=
# DISCORD_OPS_CONTENT_CHANNEL_ID=

# Market side door (middleware-node)
MARKET_API_URL=https://chainlords-middleware-production.up.railway.app
MARKET_LANDING_URL=https://www.chainlords.net/market.html

# Safety
MAX_REPLY_CHARS=900
COOLDOWN_MS=4000
MAX_HISTORY_TURNS=6
